        <script>
          const galleryPhotos = <%- JSON.stringify(displayPhotos) %>;
          const galleryLabels = <%- JSON.stringify(photoLabels) %>;

          let activeHeroIndex = 0;
          let currentPhotoIndex = 0;

          // Mode Switcher: 'showcase' or 'grid'
          function setGalleryMode(mode) {
            const showcaseSec = document.getElementById('galleryShowcaseMode');
            const gridSec = document.getElementById('galleryGridMode');
            const btnShowcase = document.getElementById('btnModeShowcase');
            const btnGrid = document.getElementById('btnModeGrid');

            if (mode === 'grid') {
              if (showcaseSec) showcaseSec.classList.remove('active-mode');
              if (gridSec) gridSec.classList.add('active-mode');
              if (btnShowcase) btnShowcase.classList.remove('active');
              if (btnGrid) btnGrid.classList.add('active');
            } else {
              if (showcaseSec) showcaseSec.classList.add('active-mode');
              if (gridSec) gridSec.classList.remove('active-mode');
              if (btnShowcase) btnShowcase.classList.add('active');
              if (btnGrid) btnGrid.classList.remove('active');
            }
          }

          // Hero Showcase Controls
          function selectHeroPhoto(idx) {
            if (!galleryPhotos || idx < 0 || idx >= galleryPhotos.length) return;
            activeHeroIndex = idx;
            updateHeroStage();
          }

          function cycleHeroPhoto(delta) {
            if (!galleryPhotos || galleryPhotos.length <= 1) return;
            activeHeroIndex = (activeHeroIndex + delta + galleryPhotos.length) % galleryPhotos.length;
            updateHeroStage();
          }

          function updateHeroStage() {
            const img = document.getElementById('masterStageImg');
            const tagText = document.getElementById('heroBadgeText');

            if (img && galleryPhotos[activeHeroIndex]) {
              img.src = galleryPhotos[activeHeroIndex];
            }

            if (tagText) {
              const label = (galleryLabels && galleryLabels[activeHeroIndex]) ? galleryLabels[activeHeroIndex] : `Photo ${activeHeroIndex + 1}`;
              tagText.innerText = `${activeHeroIndex + 1} of ${galleryPhotos.length} · ${label}`;
            }

            // Update active card highlight
            galleryPhotos.forEach((_, i) => {
              const card = document.getElementById(`featureCard-${i}`);
              if (card) {
                if (i === activeHeroIndex) {
                  card.classList.add('active');
                } else {
                  card.classList.remove('active');
                }
              }
            });
          }

          // Lightbox Controls
          function openLightbox(idx) {
            currentPhotoIndex = idx || 0;
            updateLightbox();
            renderLightboxFilmstrip();
            const modal = document.getElementById('photoLightboxModal');
            if (modal) modal.classList.add('active');
            document.body.style.overflow = 'hidden';
          }

          function closeLightbox() {
            const modal = document.getElementById('photoLightboxModal');
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = '';
          }

          function updateLightbox() {
            const img = document.getElementById('lightboxActiveImg');
            const cap = document.getElementById('lightboxCaption');
            if (img && galleryPhotos.length > 0) {
              img.src = galleryPhotos[currentPhotoIndex];
            }
            if (cap) {
              cap.innerText = `Photo ${currentPhotoIndex + 1} of ${galleryPhotos.length} — ${galleryLabels[currentPhotoIndex] || 'Listing photo'}`;
            }
            // Update active thumb
            document.querySelectorAll('.lightbox-thumb').forEach((t, i) => {
              if (i === currentPhotoIndex) {
                t.classList.add('active');
              } else {
                t.classList.remove('active');
              }
            });
          }

          function renderLightboxFilmstrip() {
            const strip = document.getElementById('lightboxFilmstrip');
            if (!strip) return;
            strip.innerHTML = '';
            if (galleryPhotos.length <= 1) return;

            galleryPhotos.forEach((pic, i) => {
              const thumb = document.createElement('img');
              thumb.src = pic;
              thumb.className = `lightbox-thumb ${i === currentPhotoIndex ? 'active' : ''}`;
              thumb.onclick = () => {
                currentPhotoIndex = i;
                updateLightbox();
              };
              strip.appendChild(thumb);
            });
          }

          function nextLightboxPhoto() {
            if (galleryPhotos.length === 0) return;
            currentPhotoIndex = (currentPhotoIndex + 1) % galleryPhotos.length;
            updateLightbox();
          }

          function prevLightboxPhoto() {
            if (galleryPhotos.length === 0) return;
            currentPhotoIndex = (currentPhotoIndex - 1 + galleryPhotos.length) % galleryPhotos.length;
            updateLightbox();
          }

          document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('photoLightboxModal');
            if (modal && modal.classList.contains('active')) {
              if (e.key === 'Escape') closeLightbox();
              if (e.key === 'ArrowRight') nextLightboxPhoto();
              if (e.key === 'ArrowLeft') prevLightboxPhoto();
            } else {
              if (e.key === 'ArrowRight') cycleHeroPhoto(1);
              if (e.key === 'ArrowLeft') cycleHeroPhoto(-1);
            }
          });

          // Dynamic Date Calculation and Conflict Checking on Home Details Card
          (function initHomeBookingCard() {
            const homePrice = <%= Number(home.price) || 150 %>;
            const bookedList = <%- JSON.stringify((existingBookings || []).map(b => ({
              start: new Date(b.checkIn).getTime(),
              end: new Date(b.checkOut).getTime(),
              startStr: new Date(b.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
              endStr: new Date(b.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
            }))) %>;

            const inEl = document.getElementById('homeCheckIn');
            const outEl = document.getElementById('homeCheckOut');
            const nightsEl = document.getElementById('homeCalcNights');
            const subtotalEl = document.getElementById('homeCalcSubtotal');
            const totalEl = document.getElementById('homeCalcTotal');
            const noticeBox = document.getElementById('homeCardConflictNotice');
            const noticeText = document.getElementById('homeCardConflictText');
            const reserveBtn = document.getElementById('homeReserveSubmitBtn');
            const btnText = document.getElementById('homeReserveBtnText');

            const maxGuestsLimit = <%= Number(home.maxGuests) || 4 %>;
            const guestsEl = document.getElementById('homeBookingGuests') || document.querySelector('select[name="guests"]');
            const guestWarningBox = document.getElementById('homeCardGuestLimitNotice');
            const guestWarningCount = document.getElementById('homeCardGuestLimitCount');

            if (!inEl || !outEl) return;

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const defIn = new Date(today);
            defIn.setDate(defIn.getDate() + 1);
            const defOut = new Date(defIn);
            defOut.setDate(defOut.getDate() + 3);

            function fmtDate(d) {
              return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            }

            inEl.min = fmtDate(today);
            outEl.min = fmtDate(defIn);
            inEl.value = fmtDate(defIn);
            outEl.value = fmtDate(defOut);

            function recompute() {
              if (!inEl.value || !outEl.value) return;

              // 1. Guest capacity check
              const guestsVal = parseInt(guestsEl ? guestsEl.value : 1, 10) || 1;
              const isExceeded = (guestsVal > maxGuestsLimit);

              if (isExceeded) {
                if (guestWarningBox) {
                  guestWarningBox.style.display = 'block';
                  if (guestWarningCount) guestWarningCount.textContent = guestsVal;
                }
                if (guestsEl) {
                  guestsEl.style.borderColor = '#EF4444';
                  guestsEl.style.backgroundColor = '#FFF1F2';
                }
                if (reserveBtn) {
                  reserveBtn.disabled = true;
                  if (btnText) btnText.textContent = `Capacity Exceeded (Max ${maxGuestsLimit} Guests)`;
                }
                return;
              } else {
                if (guestWarningBox) guestWarningBox.style.display = 'none';
                if (guestsEl) {
                  guestsEl.style.borderColor = '';
                  guestsEl.style.backgroundColor = '';
                }
              }

              const inD = new Date(inEl.value + 'T00:00:00');
              const outD = new Date(outEl.value + 'T00:00:00');

              const minNext = new Date(inD);
              minNext.setDate(minNext.getDate() + 1);
              outEl.min = fmtDate(minNext);

              if (outD <= inD) {
                if (noticeBox) {
                  noticeBox.style.display = 'block';
                  noticeText.textContent = 'Checkout must be after check-in date.';
                }
                if (reserveBtn) reserveBtn.disabled = true;
                return;
              }

              const inMs = inD.getTime();
              const outMs = outD.getTime();

              // Conflict check
              let conflict = null;
              for (const b of bookedList) {
                if (b.start < outMs && b.end > inMs) {
                  conflict = b;
                  break;
                }
              }

              const diff = outMs - inMs;
              const nights = Math.max(1, Math.round(diff / (1000 * 60 * 60 * 24)));
              const subtotal = homePrice * nights;
              const grandTotal = subtotal + 50 + 35;

              if (nightsEl) nightsEl.textContent = nights;
              if (subtotalEl) subtotalEl.textContent = `$${subtotal.toLocaleString()}`;
              if (totalEl) totalEl.textContent = `$${grandTotal.toLocaleString()}`;

              if (conflict) {
                if (noticeBox) {
                  noticeBox.style.display = 'block';
                  noticeText.innerHTML = `<strong>Unavailable:</strong> Reserved from ${conflict.startStr} to ${conflict.endStr}.`;
                }
                if (reserveBtn) {
                  reserveBtn.disabled = true;
                  if (btnText) btnText.textContent = 'Dates Unavailable';
                }
              } else {
                if (noticeBox) noticeBox.style.display = 'none';
                if (reserveBtn) {
                  reserveBtn.disabled = false;
                  if (btnText) btnText.textContent = `Reserve Stay (${nights} nights)`;
                }
              }
            }

            inEl.addEventListener('change', () => {
              const inD = new Date(inEl.value + 'T00:00:00');
              const outD = new Date(outEl.value + 'T00:00:00');
              if (outD <= inD) {
                const next = new Date(inD);
                next.setDate(next.getDate() + 3);
                outEl.value = fmtDate(next);
              }
              recompute();
            });

            outEl.addEventListener('change', recompute);

            if (guestsEl) {
              guestsEl.addEventListener('change', recompute);
              guestsEl.addEventListener('input', recompute);
            }

            const bookingForm = document.getElementById('homeBookingForm');
            if (bookingForm) {
              bookingForm.addEventListener('submit', (e) => {
                const val = parseInt(guestsEl ? guestsEl.value : 1, 10) || 1;
                if (val > maxGuestsLimit) {
                  e.preventDefault();
                  alert(`⚠️ This property accommodates a maximum of ${maxGuestsLimit} guests. You entered ${val} guests. Please reduce traveler count to proceed.`);
                  if (guestsEl) guestsEl.focus();
                }
              });
            }

            recompute();
          })();
        </script>

  </body>

  </html>