                            <!-- Amenities Grid (Dynamic from Selected Host Options) -->
                            <% function getAmenityIcon(name) { const lower=(name || '' ).toLowerCase(); if
                              (lower.includes('wi-fi') || lower.includes('wifi') || lower.includes('internet'))
                              return 'fa-solid fa-wifi' ; if (lower.includes('kitchen') || lower.includes('chef'))
                              return 'fa-solid fa-kitchen-set' ; if (lower.includes('workspace') ||
                              lower.includes('desk') || lower.includes('laptop')) return 'fa-solid fa-laptop' ; if
                              (lower.includes('pool')) return 'fa-solid fa-water-ladder' ; if (lower.includes('tub') ||
                              lower.includes('jacuzzi')) return 'fa-solid fa-hot-tub-person' ; if
                              (lower.includes('conditioning') || lower.includes('ac') || lower.includes('cooling'))
                              return 'fa-solid fa-snowflake' ; if (lower.includes('mountain'))
                              return 'fa-solid fa-mountain' ; if (lower.includes('parking') || lower.includes('garage'))
                              return 'fa-solid fa-square-parking' ; if (lower.includes('tv') ||
                              lower.includes('streaming')) return 'fa-solid fa-tv' ; if (lower.includes('washer') ||
                              lower.includes('dryer') || lower.includes('laundry')) return 'fa-solid fa-shirt' ; if
                              (lower.includes('smoke') || lower.includes('detector') || lower.includes('security'))
                              return 'fa-solid fa-shield-halved' ; if (lower.includes('coffee') ||
                              lower.includes('espresso')) return 'fa-solid fa-mug-saucer' ; if
                              (lower.includes('balcony') || lower.includes('patio')) return 'fa-solid fa-cloud-sun' ; if
